{
  "name": "agent-widget-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api,sandbox -c cyan,magenta,yellow \"npm run dev:web\" \"npm run dev:server\" \"npm run dev:sandbox\"",
    "dev:demo": "concurrently -k -n web,api,sandbox,mcp -c cyan,magenta,yellow,green \"npm run dev:web\" \"MCP_SERVERS='[{\\\"id\\\":\\\"demo\\\",\\\"url\\\":\\\"http://127.0.0.1:8790/mcp\\\"}]' npm run dev:server\" \"npm run dev:sandbox\" \"npm run demo:mcp\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:server": "tsx watch server/index.ts",
    "dev:sandbox": "tsx watch server/sandbox-server.ts",
    "demo:mcp": "tsx server/demo-mcp.ts",
    "start:server": "node dist/server/index.js",
    "start:sandbox": "node dist/server/sandbox-server.js",
    "build": "npm run typecheck && vite build && vite build --config vite.embed.config.ts && tsc -p server/tsconfig.json",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.74",
    "@fontsource-variable/dm-sans": "^5.1.1",
    "@fontsource-variable/manrope": "^5.1.1",
    "@modelcontextprotocol/client": "^2.1.0",
    "@modelcontextprotocol/ext-apps": "^2.0.0",
    "ai": "^7.0.113",
    "dotenv": "^17.2.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/express": "^2.0.1",
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.1.0",
    "express": "^5.2.1",
    "jsdom": "^25.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
