# Optional. Without this value the sample server uses deterministic mock streaming.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
API_PORT=8787

# Agent tool-loop limit, from 1 to 100.
MAX_STEPS=5

# Optional MCP servers. Credentials stay on this server and are never sent to the browser.
# MCP_SERVERS=[{"id":"tools","url":"https://mcp.example.com/mcp","headers":{"Authorization":"Bearer replace-me"}}]

# The sandbox must be served from a different origin than the widget.
MCP_SANDBOX_PORT=8789
MCP_HOST_ORIGINS=http://localhost:5173
# Exact website origins allowed above the widget when they differ from its origin.
MCP_EMBED_ANCESTOR_ORIGINS=
VITE_MCP_SANDBOX_URL=http://localhost:8789/sandbox
